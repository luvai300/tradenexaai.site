{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": { "api/*.mjs": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/auth/deriv/login", "destination": "/api/deriv-login" },
    { "source": "/auth/deriv/signup", "destination": "/api/deriv-signup" },
    { "source": "/auth/deriv/callback", "destination": "/api/deriv-callback" },
    { "source": "/favicon.ico", "destination": "/favicon.svg" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' wss://api.derivws.com; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'" }
    ]},
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/auth/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
